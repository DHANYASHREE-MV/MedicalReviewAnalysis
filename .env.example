# Copy to .env and fill in. Never commit the real .env.

# --- Database (local example; hosted URLs like postgres://... also work) ---
DB_URI=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aegiscare

# --- Google sign-in ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
AUTH_SESSION_SECRET=a-long-random-string
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
AUTH_FRONTEND_URL=http://localhost:5173

# --- AI agents and data sources ---
GROQ_API_KEY=your-groq-key
APIFY_API_KEY=
BREVO_API_KEY=
SMTP_FROM=
# Contact us form: messages are emailed here (needs BREVO_API_KEY and SMTP_FROM)
CONTACT_TO_EMAIL=dhanyashreemv27@gmail.com
# Appointment confirmations: SMS sender name (max 11 letters/digits) and country code added to 10-digit numbers
# SMS via Twilio (used when all three are set; otherwise Brevo SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio trial accounts can only send predefined templates; this one is used when custom text is refused
TWILIO_TRIAL_TEMPLATE=sms_appointment_reminders
BREVO_SMS_SENDER=AegisCare
SMS_DEFAULT_COUNTRY_CODE=91

# --- Only when the frontend is online (GitHub Pages) and the backend is hosted ---
# GOOGLE_REDIRECT_URI=https://YOUR-BACKEND-HOST/api/auth/google/callback
# AUTH_FRONTEND_URL=https://dhanyashree-mv.github.io/MedicalReviewAnalysis
# CORS_ORIGINS=https://dhanyashree-mv.github.io,http://localhost:5173
# AUTH_COOKIE_SAMESITE=none
# AUTH_HTTPS_ONLY=true

# AegisCare admin(s): approve claims of solo doctors and clinic owners (comma-separated Google emails)
AEGISCARE_ADMIN_EMAILS=dhanyashreemv63@gmail.com
# Small clinics: doctors per clinic including the owner
AEGISCARE_CLINIC_TEAM_LIMIT=5
